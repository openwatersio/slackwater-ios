{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "shouldTranslate" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Slackwater"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Slackwater gives each station you switch on its own calendar, named for that station, and keeps its tide or current events up to date. Switch the station off and Slackwater deletes that calendar and its events. It reads only calendars named for a station, to find its own, and never changes your other calendars."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater crea un calendario para cada estación que actives, con el nombre de esa estación, y mantiene al día sus eventos de marea o corriente. Desactiva la estación y Slackwater elimina ese calendario y sus eventos. Solo lee los calendarios con el nombre de una estación, para encontrar los suyos, y nunca modifica tus otros calendarios."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater crée un calendrier pour chaque station que vous activez, nommé d’après cette station, et y maintient à jour ses marées ou ses courants. Désactivez la station et Slackwater supprime ce calendrier et ses événements. Il ne lit que les calendriers portant le nom d’une station, pour retrouver les siens, et ne modifie jamais vos autres calendriers."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "System location permission prompt. Explain why Slackwater requests location and that the location remains on this device.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location helps find nearby tide and current predictions. It stays on this device."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position permet de trouver des prévisions de marée et de courant à proximité. Elle reste sur cet appareil."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación ayuda a encontrar predicciones cercanas de mareas y corrientes. Permanece en este dispositivo."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
