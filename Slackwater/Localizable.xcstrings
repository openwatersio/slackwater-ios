    "Turn on location in Settings to find nearby tides and currents." : {
      "comment" : "Location-denied explanation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere den Standort in den Einstellungen, um Gezeiten und Strömungen in der Nähe zu finden."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la ubicación en Ajustes para encontrar mareas y corrientes cercanas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la localisation dans Réglages pour trouver les marées et courants à proximité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの潮汐と潮流を探すには、「設定」で位置情報をオンにしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på posisjon i Innstillinger for å finne tidevann og strømmer i nærheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet locatie aan in Instellingen om getij en stromingen in de buurt te vinden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a localização em Ajustes para encontrar marés e correntes próximas."
          }
        }
      }
    },
    "Turning on a favourite creates a separate calendar in your Calendar app. It contains high and low tides or slack-water events, plus eclipses." : {
      "comment" : "Explanation below calendar switches. Each place gets its own calendar; event types depend on whether it predicts tides or currents.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Favoriten aktivierst, wird ein eigener Kalender in deiner Kalender-App erstellt. Er enthält Hoch- und Niedrigwasser oder Stauwasserzeiten sowie Finsternisse."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activar un favorito, se crea un calendario independiente en tu app Calendario. Contiene pleamares y bajamares o eventos de estoa, además de eclipses."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer un favori crée un calendrier distinct dans votre app Calendrier. Il contient les marées hautes et basses ou les événements d’étale, ainsi que les éclipses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りをオンにすると、カレンダーアプリに専用のカレンダーが作成されます。満潮・干潮または潮止まりと、日食・月食が登録されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du slår på en favoritt, opprettes en egen kalender i Kalender-appen. Den inneholder høyvann og lavvann eller strømstille, samt formørkelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een favoriet aanzet, wordt een aparte kalender gemaakt in je Kalender-app. Deze bevat hoog- en laagwater of kenteringen, plus verduisteringen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar um favorito cria um calendário separado no app Calendário. Ele contém preamares e baixa-mares ou eventos de estofo da corrente, além de eclipses."
          }
        }
      }
    },
