    },
    "(Tell us what you know — who runs this gauge, a contact there, or anything about how its data is licensed.)" : {
      "comment" : "Prompt in an email about an unavailable station.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Cuéntanos lo que sepas: quién gestiona este mareógrafo, algún contacto o cualquier dato sobre la licencia de sus datos.)"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Dites-nous ce que vous savez — qui exploite cette station, une personne-ressource ou toute information sur la licence de ses données.)"
          }
        }
      }
    },
    "(Tell us what you saw — what the water was doing, and when.)" : {
      "comment" : "Prompt in an email reporting a prediction problem.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Cuéntanos lo que viste: qué hacía el agua y cuándo.)"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Dites-nous ce que vous avez observé — ce que faisait l’eau et à quel moment.)"
          }
        }
      }
    },
