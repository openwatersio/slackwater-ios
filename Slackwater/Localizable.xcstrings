    "If you know who operates this station or how its data is licensed, let us know." : {
      "comment" : "Station discovery interface text.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæl os, hvis du ved, hvem der driver denne station, eller hvordan dens data er licenseret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du weißt, wer diese Station betreibt oder wie ihre Daten lizenziert sind, lass es uns wissen."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sabes quién gestiona esta estación o qué licencia tienen sus datos, cuéntanoslo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tiedät, kuka ylläpitää asemaa tai miten sen tiedot on lisensoitu, kerro meille."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous savez qui exploite cette station ou sous quelle licence ses données sont diffusées, dites-le-nous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sai chi gestisce questa stazione o come sono concessi i suoi dati, faccelo sapere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この観測所の運営者やデータの利用許諾をご存じでしたら、お知らせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 관측소의 운영자나 데이터 이용 허가에 관해 아신다면 알려 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi oss beskjed hvis du vet hvem som driver denne stasjonen, eller hvordan dataene er lisensiert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat het ons weten als je weet wie dit station beheert of hoe de gegevens zijn gelicentieerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sabe quem opera esta estação ou qual é a licença dos dados, conte para nós."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sabe quem gere esta estação ou qual é a licença dos dados, informe-nos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berätta för oss om du vet vem som driver den här stationen eller hur dess data licensieras."
          }
        }
      }
    },
    "In Earth's faint outer shadow — a dimming, not a bite." : {
      "comment" : "Plain-language explanation of a penumbral lunar eclipse.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Jordens svage ydre skygge — en dæmpning, ikke en manglende bid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im schwachen äußeren Erdschatten — etwas dunkler, ohne sichtbare Einkerbung."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la tenue sombra exterior de la Tierra: un oscurecimiento, no un mordisco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maan himmeässä puolivarjossa — himmenee, mutta palanen ei peity."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la faible pénombre de la Terre — un assombrissement, pas une échancrure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella tenue ombra esterna della Terra: si oscura, senza intaccarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球の薄い外側の影に入り、欠けずに少し暗くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지구의 옅은 바깥 그림자에 들어가 어두워집니다. 일부가 가려지는 것은 아닙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Jordens svake ytre skygge — mørkere, uten en bit som mangler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de zwakke buitenste schaduw van de aarde — minder helder, zonder hap eruit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na penumbra da Terra — um escurecimento, sem recorte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na penumbra da Terra — um escurecimento, sem recorte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I jordens svaga yttre skugga — en dämpning, ingen bit som saknas."
          }
        }
      }
    },
