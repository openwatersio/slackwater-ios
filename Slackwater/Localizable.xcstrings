    "%@ chart datum. Based on %@ tides and NOAA's published offsets; computed on this device." : {
      "comment" : "Offline-download interface text. Placeholders are runtime values shown in context.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Seekartennull. Auf Grundlage der Gezeiten von %2$@ und der von NOAA veröffentlichten Korrekturen; auf diesem Gerät berechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ chart datum. Based on %2$@ tides and NOAA's published offsets; computed on this device."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cero hidrográfico: %1$@. Basado en las mareas de %2$@ y los desfases publicados por NOAA; calculado en este dispositivo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zéro des cartes : %1$@. D’après les marées de %2$@ et les corrections publiées par NOAA; calculé sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海図基準面：%1$@。%2$@の潮汐とNOAAが公開する補正値に基づき、このデバイスで計算しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sjøkartnull. Basert på tidevannet ved %2$@ og NOAAs publiserte korreksjoner; beregnet på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kaartnul. Gebaseerd op het getij bij %2$@ en de door NOAA gepubliceerde correcties; berekend op dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nível de redução %1$@. Baseado nas marés de %2$@ e nas correções publicadas pela NOAA; calculado neste dispositivo."
          }
        }
      }
    },
    "%@ chart datum. Downloaded from CHS (IWLS), then fitted and computed on this device. These are not CHS-published predictions." : {
      "comment" : "Offline-download interface text. Placeholders are runtime values shown in context.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Seekartennull. Von CHS (IWLS) geladen, dann auf diesem Gerät angepasst und berechnet. Diese Vorhersagen werden nicht von CHS veröffentlicht."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cero hidrográfico: %@. Descargado de CHS (IWLS), ajustado y calculado en este dispositivo. No son predicciones publicadas por CHS."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zéro des cartes : %1$@. Données téléchargées de CHS (IWLS), puis ajustées et calculées sur cet appareil. Ces prévisions ne sont pas publiées par CHS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
