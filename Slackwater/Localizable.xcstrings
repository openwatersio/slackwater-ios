    "— details —" : {
      "comment" : "Heading in a generated problem-report email.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— detalles —"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
