          }
        }
      }
    },
    "Slackwater doesn't have predictions for this tide station." : {
      "comment" : "Station discovery interface text.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater no tiene predicciones para esta estación de mareas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater ne dispose pas de prévisions pour cette station de marée."
          }
        }
      }
    },
    "Slackwater estimates %@ slack times from high and low water at %@, using a cruising rule of thumb. CHS does not publish current predictions for this pass." : {
      "comment" : "Tide and current interface text. Placeholders are runtime values shown in context.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Slackwater estimates %1$@ slack times from high and low water at %2$@, using a cruising rule of thumb. CHS does not publish current predictions for this pass."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater estima las horas de estoa de %@ a partir de la pleamar y la bajamar en %@, mediante una regla práctica de navegación. CHS no publica predicciones de corrientes para este paso."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater estime %1$@ périodes d’étale à partir des hautes et basses eaux à %2$@, selon une règle empirique de navigation. CHS ne publie pas de prévisions de courant pour ce passage."
          }
        }
      }
    },
    "Slackwater is open source: this app under GPL-3.0, the prediction engine under MIT." : {
      "comment" : "Tide and current interface text.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
