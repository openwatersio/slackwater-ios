    "This station's predictions aren't on this device yet. Downloading Canadian current predictions…" : {
      "comment" : "Station download explanation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorhersagen für diese Station sind noch nicht auf diesem Gerät. Kanadische Strömungsvorhersagen werden geladen…"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las predicciones de esta estación aún no están en este dispositivo. Descargando predicciones de corrientes canadienses…"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prévisions de cette station ne sont pas encore sur cet appareil. Téléchargement des prévisions canadiennes de courant…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この観測所の予測はまだこのデバイスにありません。カナダの潮流予測をダウンロード中…"
          }
        },
        "nb" : {
          "stringUnit" : {
