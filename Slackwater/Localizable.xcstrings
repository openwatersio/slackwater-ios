    "A sliver, growing a little fuller each night." : {
      "comment" : "Plain-language explanation of a waxing crescent moon.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En smal segl, der bliver lidt fyldigere hver nat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine schmale Sichel, die jede Nacht etwas voller wird."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fino creciente que aumenta un poco cada noche."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohut sirppi, joka kasvaa hieman joka yö."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un croissant, qui grandit un peu plus chaque nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una falce sottile, un po’ più piena ogni notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細い月が、夜ごとに少しずつ満ちていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가느다란 달이 밤마다 조금씩 차오릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En smal sigd som vokser litt hver natt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een smalle sikkel die elke nacht iets voller wordt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma faixa fina, um pouco mais iluminada a cada noite."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma faixa fina, um pouco mais iluminada a cada noite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En skära som blir lite fylligare varje natt."
          }
        }
      }
    },
    "A thinning sliver, a few nights from new." : {
