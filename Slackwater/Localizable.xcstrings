    "Slackwater" : {
      "shouldTranslate" : false
    },
    "Slackwater computes harmonic tide and current predictions on this device. They are not observations; actual conditions vary with weather, river flow, and local effects." : {
      "comment" : "Tide and current interface text.",
      "localizations" : {
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater calcule les prévisions harmoniques des marées et courants sur cet appareil. Il ne s’agit pas d’observations; les conditions réelles varient selon la météo, le débit des cours d’eau et les effets locaux."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater calcula predicciones armónicas de mareas y corrientes en este dispositivo. No son observaciones; las condiciones reales varían con el tiempo, el caudal de los ríos y los efectos locales."
          }
        }
      }
    },
    "Slackwater couldn't find a slack window for your nearest current station." : {
      "comment" : "Spoken Siri failure response.",
      "localizations" : {
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater n’a pas trouvé de fenêtre d’étale pour votre station de courant la plus proche."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater no encontró una ventana de estoa para la estación de corrientes más cercana."
          }
        }
      }
    },
    "Slackwater couldn't find a tide prediction for your local station." : {
      "comment" : "Spoken Siri failure response.",
      "localizations" : {
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater n’a pas trouvé de prévision de marée pour votre station locale."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater no encontró una predicción de marea para tu estación local."
          }
        }
      }
    },
    "Slackwater doesn't have predictions for this tide station." : {
      "comment" : "Station discovery interface text.",
      "localizations" : {
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater ne dispose pas de prévisions pour cette station de marée."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater no tiene predicciones para esta estación de mareas."
          }
        }
      }
    },
    "Slackwater estimates %@ slack times from high and low water at %@, using a cruising rule of thumb. CHS does not publish current predictions for this pass." : {
      "comment" : "Tide and current interface text. Placeholders are runtime values shown in context.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Slackwater estimates %1$@ slack times from high and low water at %2$@, using a cruising rule of thumb. CHS does not publish current predictions for this pass."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater estime %1$@ périodes d’étale à partir des hautes et basses eaux à %2$@, selon une règle empirique de navigation. CHS ne publie pas de prévisions de courant pour ce passage."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater estima las horas de estoa de %@ a partir de la pleamar y la bajamar en %@, mediante una regla práctica de navegación. CHS no publica predicciones de corrientes para este paso."
          }
        }
      }
    },
    "Slackwater is open source: this app under GPL-3.0, the prediction engine under MIT." : {
      "comment" : "Tide and current interface text.",
      "localizations" : {
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater est à code source ouvert : cette app est sous GPL-3.0 et le moteur de prévision, sous MIT."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater es de código abierto: esta app usa GPL-3.0 y el motor de predicción usa MIT."
          }
        }
      }
    },
