    "(Tell us what you know — who runs this gauge, a contact there, or anything about how its data is licensed.)" : {
      "comment" : "Prompt in an email about an unavailable station.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Erzähle uns, was du weißt — wer diesen Pegel betreibt, wen man dort kontaktieren kann oder wie die Daten lizenziert sind.)"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Cuéntanos lo que sepas: quién gestiona este mareógrafo, algún contacto o cualquier dato sobre la licencia de sus datos.)"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Dites-nous ce que vous savez — qui exploite cette station, une personne-ressource ou toute information sur la licence de ses données.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（ご存じのことを教えてください。この観測所の運営者、連絡先、データの利用許諾など、どのような情報でも構いません。）"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Fortell oss det du vet — hvem som driver denne måleren, en kontaktperson der eller noe om lisensen for dataene.)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Vertel ons wat je weet — wie deze peilmeter beheert, een contactpersoon daar of iets over de licentie van de gegevens.)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Conte o que sabe — quem opera esta estação, um contato ou qualquer informação sobre a licença dos dados.)"
          }
        }
      }
    },
    "(Tell us what you saw — what the water was doing, and when.)" : {
      "comment" : "Prompt in an email reporting a prediction problem.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Erzähle uns, was du beobachtet hast — wie sich das Wasser verhalten hat und wann.)"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Cuéntanos lo que viste: qué hacía el agua y cuándo.)"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Dites-nous ce que vous avez observé — ce que faisait l’eau et à quel moment.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（水面や流れの様子と、それを見た日時を教えてください。）"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Fortell oss hva du så — hvordan vannet oppførte seg, og når.)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Vertel ons wat je zag — wat het water deed en wanneer.)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Conte o que viu — como estava a água e quando.)"
          }
        }
      }
    },
