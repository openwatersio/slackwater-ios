    "Publish a station's tides or slack windows to your calendar" : {
      "comment" : "Settings calendar row when no place is subscribed.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føj en stations tidevand eller strømstille perioder til din kalender"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezeiten oder Stauwasserfenster einer Station im Kalender eintragen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publish a station's tides or slack windows to your calendar"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade a tu calendario las mareas o ventanas de estoa de una estación"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää aseman vuorovedet tai heikon virtauksen jaksot kalenteriisi"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les marées ou fenêtres d’étale d’une station à votre calendrier"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi al calendario le maree o le finestre di stanca di una stazione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "観測所の潮汐や潮止まり時間帯をカレンダーに追加"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관측소의 조석이나 정조 시간대를 캘린더에 추가"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg en stasjons tidevann eller strømstillevinduer i kalenderen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg getijden of kenteringsvensters van een station toe aan je agenda"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione as marés ou janelas de estofo de uma estação ao seu calendário"
