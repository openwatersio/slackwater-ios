      "comment" : "Station line in a generated problem-report email. Values are the station name and stable identifier.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Station: %1$@ (%2$@)"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estación: %1$@ (%2$@)"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Station : %1$@ (%2$@)"
          }
        }
      }
    },
    "Stations marked \"Predictions unavailable\" are named from non-commercial records in the same SEANOE deposit (CC BY-NC 4.0). Slackwater does not bundle or serve their harmonic constants." : {
      "comment" : "Station discovery interface text.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las estaciones marcadas como «Predicciones no disponibles» reciben sus nombres de registros no comerciales del mismo depósito de SEANOE (CC BY-NC 4.0). Slackwater no incluye ni distribuye sus constantes armónicas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les stations marquées « Prévisions indisponibles » sont nommées à partir d’enregistrements non commerciaux dans le même dépôt SEANOE (CC BY-NC 4.0). Slackwater n’inclut ni ne diffuse leurs constantes harmoniques."
          }
        }
      }
    },
    "Stations ready: %lld of %lld" : {
      "comment" : "Background download activity. Values are ready and total station counts.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estaciones listas: %1$lld de %2$lld"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stations prêtes : %1$lld sur %2$lld"
          }
        }
      }
    },
    "Stay connected for %@ more and Slackwater refines it to the full %lld-day model, in place — nothing to tap." : {
      "comment" : "Online prediction-refinement explanation. Values are an approximate duration and model length in days.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stay connected for %1$@ more and Slackwater refines it to the full %2$lld-day model, in place — nothing to tap."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la conexión %@ más y Slackwater la refinará al modelo completo de %lld días, sin que tengas que tocar nada."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez connecté encore %1$@ et Slackwater affinera cette réponse grâce au modèle complet de %2$lld jours, sans aucune action de votre part."
          }
        }
      }
    },
    "Sunrise" : {
      "comment" : "Next-event label.\nVoiceOver next-event label.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
