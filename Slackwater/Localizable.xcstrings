    "Slackwater needs calendar access to publish a station's events. Turn it on in Settings → Slackwater." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater har brug for kalenderadgang for at offentliggøre en stations begivenheder. Slå den til i Indstillinger → Slackwater."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater benötigt Kalenderzugriff, um die Ereignisse einer Station zu veröffentlichen. Aktiviere ihn unter Einstellungen → Slackwater."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater necesita acceso al calendario para publicar los eventos de una estación. Actívalo en Ajustes → Slackwater."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater tarvitsee kalenterin käyttöoikeuden aseman tapahtumien julkaisemiseen. Salli käyttö kohdassa Asetukset → Slackwater."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater a besoin d’accéder au calendrier pour publier les événements d’une station. Activez-le dans Réglages → Slackwater."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater richiede accesso al calendario per pubblicare gli eventi di una stazione. Attivalo in Impostazioni → Slackwater."
          }
