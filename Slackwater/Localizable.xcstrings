            "value" : "Esta estación quedará disponible sin conexión al terminar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette station restera disponible hors ligne une fois terminée."
          }
        }
      }
    },
    "This station's predictions aren't on this device yet. Downloading Canadian current predictions…" : {
      "comment" : "Station download explanation.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
