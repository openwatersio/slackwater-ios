    "(Tell us what you know — who runs this gauge, a contact there, or anything about how its data is licensed.)" : {
      "comment" : "Prompt in an email about an unavailable station.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Fortæl os, hvad du ved — hvem der driver denne måler, en kontakt der eller noget om, hvordan dataene er licenseret.)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Erzähle uns, was du weißt — wer diesen Pegel betreibt, wen man dort kontaktieren kann oder wie die Daten lizenziert sind.)"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Cuéntanos lo que sepas: quién gestiona este mareógrafo, algún contacto o cualquier dato sobre la licencia de sus datos.)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Kerro, mitä tiedät: kuka ylläpitää mittausasemaa, keneltä voi kysyä tai miten sen tietojen käyttö on lisensoitu.)"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Dites-nous ce que vous savez — qui exploite cette station, une personne-ressource ou toute information sur la licence de ses données.)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Raccontaci ciò che sai: chi gestisce questo mareografo, un contatto o informazioni sulla licenza dei dati.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（ご存じのことを教えてください。この観測所の運営者、連絡先、データの利用許諾など、どのような情報でも構いません。）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(아시는 내용을 알려 주세요. 이 관측소의 운영자, 연락처 또는 데이터 이용 허가에 관한 정보가 도움이 됩니다.)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Fortell oss det du vet — hvem som driver denne måleren, en kontaktperson der eller noe om lisensen for dataene.)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Vertel ons wat je weet — wie deze peilmeter beheert, een contactpersoon daar of iets over de licentie van de gegevens.)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Conte o que sabe — quem opera esta estação, um contato ou qualquer informação sobre a licença dos dados.)"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Diga-nos o que sabe — quem gere este mareógrafo, um contacto ou informações sobre a licença dos dados.)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Berätta vad du vet — vem som driver mätaren, en kontakt där eller något om hur data licensieras.)"
          }
        }
      }
    },
    "(Tell us what you saw — what the water was doing, and when.)" : {
      "comment" : "Prompt in an email reporting a prediction problem.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Fortæl os, hvad du så — hvordan vandet bevægede sig, og hvornår.)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Erzähle uns, was du beobachtet hast — wie sich das Wasser verhalten hat und wann.)"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Cuéntanos lo que viste: qué hacía el agua y cuándo.)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Kerro, mitä havaitsit: miten vesi liikkui ja milloin.)"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Dites-nous ce que vous avez observé — ce que faisait l’eau et à quel moment.)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Raccontaci ciò che hai visto: cosa faceva l’acqua e quando.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（水面や流れの様子と、それを見た日時を教えてください。）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(관찰하신 물의 상태와 시간을 알려 주세요.)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Fortell oss hva du så — hvordan vannet oppførte seg, og når.)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Vertel ons wat je zag — wat het water deed en wanneer.)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Conte o que viu — como estava a água e quando.)"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Diga-nos o que viu — o que a água estava a fazer e quando.)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Berätta vad du såg — hur vattnet rörde sig och när.)"
          }
        }
      }
    },
