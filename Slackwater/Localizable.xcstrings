    "Fully inside Earth's shadow, reddened by Earth's sunsets." : {
      "comment" : "Plain-language explanation of a total lunar eclipse.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollständig im Erdschatten, rötlich durch die Sonnenuntergänge auf der Erde."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente dentro de la sombra oscura de la Tierra, enrojecida por los atardeceres terrestres."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entièrement dans l’ombre de la Terre, rougie par les couchers de soleil terrestres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月全体が地球の影に入り、地球の夕焼けの光で赤く見えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt inne i Jordens skygge, rødfarget av Jordens solnedganger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig in de schaduw van de aarde, rood gekleurd door de aardse zonsondergangen."
