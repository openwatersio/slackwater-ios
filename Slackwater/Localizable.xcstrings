    "Can you help?" : {
      "comment" : "Slackwater interface text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannst du helfen?"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puedes ayudarnos?"
          }
        },
        "fr-CA" : {
