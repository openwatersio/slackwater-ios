    "Downloaded from CHS (IWLS), then fitted and computed on this device. These are not CHS-published predictions. Flood sets %lld°T." : {
      "comment" : "Offline-download interface text. Placeholders are runtime values shown in context.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von CHS (IWLS) geladen, dann auf diesem Gerät angepasst und berechnet. Diese Vorhersagen werden nicht von CHS veröffentlicht. Flutstrom setzt nach %lld°T."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargado de CHS (IWLS), ajustado y calculado en este dispositivo. No son predicciones publicadas por CHS. La corriente de flujo se establece a %lld°T."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données téléchargées de CHS (IWLS), puis ajustées et calculées sur cet appareil. Ces prévisions ne sont pas publiées par CHS. Le flot porte au %lld°T."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CHS（IWLS）からダウンロードしたデータにこのデバイスでモデルを当てはめ、計算しています。CHSが公開する予測値ではありません。上げ潮流の流向は%lld°Tです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lastet ned fra CHS (IWLS), deretter tilpasset og beregnet på denne enheten. Dette er ikke prognoser publisert av CHS. Inngående strøm setter mot %lld°T."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedownload van CHS (IWLS), daarna aangepast en berekend op dit apparaat. Deze voorspellingen zijn niet door CHS gepubliceerd. De vloedstroom zet naar %lld°T."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados baixados do CHS (IWLS), depois ajustados e calculados neste dispositivo. Estas previsões não são publicadas pelo CHS. A enchente segue para %lld°T."
          }
        }
      }
    },
    "Downloaded predictions are ready offline. Downloads that expire show their remaining time below." : {
      "comment" : "Offline-download completion summary.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geladene Vorhersagen sind offline verfügbar. Bei zeitlich begrenzten Downloads wird unten die verbleibende Zeit angezeigt."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las predicciones descargadas están listas sin conexión. Las descargas que caducan muestran abajo el tiempo restante."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prévisions téléchargées sont prêtes pour une utilisation hors ligne. Les téléchargements qui expirent affichent leur temps restant ci-dessous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みの予測はオフラインで利用できます。有効期限のあるデータは、残り時間を下に表示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
