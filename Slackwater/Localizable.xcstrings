    "Support Slackwater's development." : {
      "comment" : "Premium support copy on platforms without lock-screen widgets.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Støt udviklingen af Slackwater."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstütze die Entwicklung von Slackwater."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya el desarrollo de Slackwater."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tue Slackwaterin kehitystä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
