    "Waiting for signal. Areas already downloaded keep working offline." : {
      "comment" : "Offline-map download status.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Verbindung. Bereits geladene Bereiche funktionieren weiterhin offline."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando señal. Las zonas ya descargadas siguen funcionando sin conexión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de signal. Les zones déjà téléchargées continuent de fonctionner hors ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続待ち。ダウンロード済みのエリアはオフラインでも利用できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på signal. Områder som allerede er lastet ned, fortsetter å virke frakoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op verbinding. Al gedownloade gebieden blijven offline werken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando sinal. As áreas já baixadas continuam funcionando offline."
          }
        }
      }
    },
    "Waiting for signal. Downloads resume when you're connected; anything already available keeps working offline." : {
      "comment" : "Offline-download summary while offline.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Verbindung. Downloads werden fortgesetzt, sobald du verbunden bist; alles bereits Verfügbare funktioniert weiterhin offline."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando señal. Las descargas se reanudan cuando te conectas; todo lo que ya está disponible sigue funcionando sin conexión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de signal. Les téléchargements reprennent dès que vous êtes connecté ; tout ce qui est déjà disponible continue de fonctionner hors ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続待ち。接続するとダウンロードを再開します。利用可能なデータはオフラインでも使えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på signal. Nedlastingene fortsetter når du er tilkoblet; alt som allerede er tilgjengelig, fortsetter å virke frakoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op verbinding. Downloads gaan verder zodra je verbinding hebt; alles wat al beschikbaar is blijft offline werken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando sinal. Os downloads continuam quando houver conexão; tudo que já está disponível continua funcionando offline."
          }
        }
      }
    },
    "Waiting for signal. The map downloads the world, the water around you, and your saved stations as soon as you're connected." : {
      "comment" : "Offline-map download status.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Verbindung. Die Karte lädt die Welt, die Gewässer in deiner Nähe und deine gespeicherten Stationen, sobald du verbunden bist."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando señal. El mapa descargará el mundo, el agua a tu alrededor y tus estaciones guardadas en cuanto te conectes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de signal. La carte télécharge le monde entier, les eaux autour de vous et vos stations enregistrées dès que vous êtes connecté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続待ち。接続すると、世界地図、近くの水域、保存した観測所の地図をダウンロードします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på signal. Kartet laster ned verden, farvannet rundt deg og de lagrede stasjonene dine så snart du er tilkoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op verbinding. De kaart downloadt de wereld, het water om je heen en je opgeslagen stations zodra je verbinding hebt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando sinal. O mapa baixa o mundo, as águas próximas e suas estações salvas assim que houver conexão."
          }
        }
      }
    },
