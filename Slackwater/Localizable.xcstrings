    "Offline — needs a moment of signal. Canadian predictions download once, then work offline." : {
      "comment" : "VoiceOver download status.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline — har brug for signal et øjeblik. Canadiske prognoser hentes én gang og virker derefter offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline — braucht kurz eine Verbindung. Kanadische Vorhersagen werden einmal geladen und funktionieren dann offline."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión — necesita un momento de señal. Las predicciones canadienses se descargan una vez y después funcionan sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei verkkoyhteyttä — tarvitsee hetken yhteyden. Kanadan ennusteet ladataan kerran, minkä jälkeen ne toimivat ilman verkkoyhteyttä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors ligne — nécessite un instant de connexion. Les prévisions canadiennes se téléchargent une fois, puis fonctionnent hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline — serve un momento di segnale. Le previsioni canadesi si scaricano una volta, poi funzionano offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフライン — 接続が必要です。カナダの予測は一度ダウンロードすると、オフラインで利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 — 잠시 연결이 필요합니다. 캐나다 예측은 한 번 다운로드하면 오프라인으로 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frakoblet — trenger signal et øyeblikk. Kanadiske prognoser lastes ned én gang og virker deretter frakoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline — even verbinding nodig. Canadese voorspellingen worden één keer gedownload en werken daarna offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline — precisa de um momento de sinal. As previsões canadenses são baixadas uma vez e depois funcionam offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem ligação — precisa de um momento de sinal. As previsões canadianas são descarregadas uma vez e depois funcionam sem ligação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline — behöver signal en stund. Kanadensiska prognoser hämtas en gång och fungerar sedan offline."
          }
        }
      }
    },
