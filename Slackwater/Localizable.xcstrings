    "No Canadian predictions to download here — you're outside the range where they'd be useful. Stations near you work offline already." : {
      "comment" : "Offline-download summary outside Canadian coverage.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen canadiske prognoser at hente her — du er uden for området, hvor de er nyttige. Stationer nær dig virker allerede offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier gibt es keine kanadischen Vorhersagen zum Laden — du bist außerhalb des Bereichs, in dem sie nützlich wären. Stationen in deiner Nähe funktionieren bereits offline."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay predicciones canadienses que descargar aquí: estás fuera de la zona donde serían útiles. Las estaciones cercanas ya funcionan sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täällä ei ole ladattavia Kanadan ennusteita — olet niiden hyödyllisen alueen ulkopuolella. Lähiasemat toimivat jo ilman verkkoyhteyttä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune prévision canadienne à télécharger ici — vous êtes hors de la zone utile. Les stations proches fonctionnent déjà hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna previsione canadese da scaricare qui: sei fuori dalla zona in cui sarebbe utile. Le stazioni vicine funzionano già offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでダウンロードできるカナダの予測はありません。予測が役立つ範囲の外にいます。近くの観測所はすでにオフラインで利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서는 다운로드할 캐나다 예측이 없습니다. 유용한 범위를 벗어났습니다. 주변 관측소는 이미 오프라인으로 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen kanadiske prognoser å laste ned her — du er utenfor området der de er nyttige. Stasjonene nær deg virker allerede frakoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier zijn geen Canadese voorspellingen om te downloaden — je bent buiten het gebied waar ze nuttig zouden zijn. Stations in je buurt werken al offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há previsões canadenses para baixar aqui — você está fora da área onde seriam úteis. As estações próximas já funcionam offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há previsões canadianas para descarregar aqui — está fora da área onde seriam úteis. As estações próximas já funcionam sem ligação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga kanadensiska prognoser att hämta här — du är utanför området där de är användbara. Stationer nära dig fungerar redan offline."
          }
        }
      }
    },
