    "Slackwater retries automatically when a connection is available." : {
      "comment" : "Station download retry expectation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater versucht es automatisch erneut, sobald eine Verbindung verfügbar ist."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater vuelve a intentarlo automáticamente cuando hay conexión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater réessaie automatiquement dès qu’une connexion est disponible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が利用できると、Slackwaterが自動で再試行します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater prøver igjen automatisk når en tilkobling er tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater probeert het automatisch opnieuw zodra er een verbinding beschikbaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater tenta novamente automaticamente quando há conexão."
          }
        }
      }
    },
    "Slackwater will stop publishing to this calendar, but calendar access is off, so it can't remove the calendar itself. Delete it by hand in Calendar if you don't want it anymore." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater veröffentlicht keine weiteren Ereignisse in diesem Kalender. Da der Kalenderzugriff ausgeschaltet ist, kann der Kalender selbst nicht entfernt werden. Lösche ihn bei Bedarf manuell in der Kalender-App."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater dejará de publicar en este calendario, pero el acceso al calendario está desactivado, así que no puede eliminar el calendario. Elimínalo a mano en Calendario si ya no lo quieres."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater cessera de publier dans ce calendrier, mais l’accès au calendrier est désactivé et il ne peut donc pas supprimer le calendrier lui-même. Supprimez-le manuellement dans Calendrier si vous n’en voulez plus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwaterはこのカレンダーへの公開を停止します。ただし、カレンダーへのアクセスがオフのため、カレンダー自体は削除できません。不要な場合は、カレンダーアプリで手動で削除してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater slutter å publisere i denne kalenderen, men kalendertilgangen er av, så selve kalenderen kan ikke fjernes. Slett den manuelt i Kalender hvis du ikke vil ha den lenger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater stopt met publiceren in deze kalender, maar kalendertoegang staat uit, waardoor de kalender zelf niet kan worden verwijderd. Verwijder hem handmatig in Kalender als je hem niet meer wilt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater deixará de publicar neste calendário, mas o acesso ao calendário está desativado, então não pode remover o calendário em si. Exclua-o manualmente no Calendário se não quiser mais usá-lo."
          }
        }
      }
    },
