            "state" : "translated",
            "value" : "Verbinde dich kurz, um Vorhersagen für etwa einen Monat zu laden."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate un momento para descargar aproximadamente un mes de predicciones."
          }
        },
