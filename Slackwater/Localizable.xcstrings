    "It has been withdrawn from the hydrographic service, so it has no readings to show." : {
      "comment" : "Removed-station explanation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der hydrographische Dienst hat sie zurückgezogen, daher sind keine Werte verfügbar."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha retirado del servicio hidrográfico, por lo que no hay lecturas que mostrar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a été retirée du service hydrographique et n’a donc aucun relevé à afficher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水路機関による公開が終了したため、表示できるデータがありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er trukket fra den hydrografiske tjenesten og har ingen målinger å vise."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hydrografische dienst heeft het station ingetrokken, waardoor er geen waarden meer zijn om te tonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi retirada do serviço hidrográfico e não tem leituras para exibir."
          }
        }
      }
    },
    "It has been withdrawn from the hydrographic service, so it has no readings to show. Swipe to remove it." : {
      "comment" : "Removed favorite-station explanation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der hydrographische Dienst hat sie zurückgezogen, daher sind keine Werte verfügbar. Streiche, um sie zu entfernen."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha retirado del servicio hidrográfico, por lo que no hay lecturas que mostrar. Desliza para eliminarla."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirée du service hydrographique, elle ne fournit plus de relevés. Balayez pour la supprimer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水路機関による公開が終了したため、表示できるデータがありません。スワイプして削除できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er trukket fra den hydrografiske tjenesten og har ingen målinger å vise. Sveip for å fjerne den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hydrografische dienst heeft het station ingetrokken, waardoor er geen waarden meer zijn om te tonen. Veeg om het te verwijderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi retirada do serviço hidrográfico e não tem leituras para exibir. Deslize para removê-la."
          }
        }
      }
    },
    "It's %@ in line — moved up because you opened it." : {
      "comment" : "Station download queue position. The value is a locale-formatted ordinal.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist %@ in der Warteschlange — vorgezogen, weil du sie geöffnet hast."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en el puesto %@ de la cola; ha avanzado porque la abriste."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est %@ dans la file — déplacée vers le haut car vous l’avez ouverte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待ち順は%@です。開いたため優先順位が上がりました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er %@ i køen — flyttet frem fordi du åpnet den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het staat %@ in de wachtrij — naar voren gehaald omdat je het hebt geopend."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É %@ na fila — avançou porque você a abriu."
          }
        }
      }
    },
    "It's first in line — moved to the front because you opened it." : {
      "comment" : "Station download queue position.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist zuerst an der Reihe — vorgezogen, weil du sie geöffnet hast."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
