    "Waiting for signal. Areas already downloaded keep working offline." : {
      "comment" : "Offline-map download status.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på signal. Allerede hentede områder bliver ved med at virke offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Verbindung. Bereits geladene Bereiche funktionieren weiterhin offline."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando señal. Las zonas ya descargadas siguen funcionando sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan yhteyttä. Jo ladatut alueet toimivat edelleen ilman verkkoyhteyttä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de signal. Les zones déjà téléchargées continuent de fonctionner hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di segnale. Le aree già scaricate continuano a funzionare offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続待ち。ダウンロード済みのエリアはオフラインでも利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 대기 중. 이미 다운로드된 영역은 오프라인에서도 계속 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på signal. Områder som allerede er lastet ned, fortsetter å virke frakoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op verbinding. Al gedownloade gebieden blijven offline werken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando sinal. As áreas já baixadas continuam funcionando offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aguardar sinal. As áreas já descarregadas continuam a funcionar sem ligação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntar på signal. Redan hämtade områden fortsätter fungera offline."
          }
        }
      }
    },
    "Waiting for signal. Downloads resume when you're connected; anything already available keeps working offline." : {
      "comment" : "Offline-download summary while offline.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på signal. Hentninger fortsætter, når du har forbindelse; alt, der allerede er tilgængeligt, virker offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Verbindung. Downloads werden fortgesetzt, sobald du verbunden bist; alles bereits Verfügbare funktioniert weiterhin offline."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando señal. Las descargas se reanudan cuando te conectas; todo lo que ya está disponible sigue funcionando sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan yhteyttä. Lataukset jatkuvat, kun olet verkossa; jo käytettävissä olevat tiedot toimivat ilman verkkoyhteyttä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de signal. Les téléchargements reprennent dès que vous êtes connecté ; tout ce qui est déjà disponible continue de fonctionner hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di segnale. I download riprendono quando sei connesso; tutto ciò che è già disponibile continua a funzionare offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続待ち。接続するとダウンロードを再開します。利用可能なデータはオフラインでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 대기 중. 연결되면 다운로드를 재개하며 이미 사용 가능한 자료는 오프라인에서도 계속 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på signal. Nedlastingene fortsetter når du er tilkoblet; alt som allerede er tilgjengelig, fortsetter å virke frakoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op verbinding. Downloads gaan verder zodra je verbinding hebt; alles wat al beschikbaar is blijft offline werken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando sinal. Os downloads continuam quando houver conexão; tudo que já está disponível continua funcionando offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aguardar sinal. As descargas são retomadas quando houver ligação; tudo o que já está disponível continua a funcionar sem ligação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntar på signal. Hämtningarna fortsätter när du är ansluten; allt som redan finns fungerar offline."
          }
        }
      }
    },
    "Waiting for signal. The map downloads the world, the water around you, and your saved stations as soon as you're connected." : {
      "comment" : "Offline-map download status.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på signal. Kortet henter verden, farvandet omkring dig og dine gemte stationer, så snart du har forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Verbindung. Die Karte lädt die Welt, die Gewässer in deiner Nähe und deine gespeicherten Stationen, sobald du verbunden bist."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando señal. El mapa descargará el mundo, el agua a tu alrededor y tus estaciones guardadas en cuanto te conectes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan yhteyttä. Kartta lataa koko maailman, lähivedet ja tallennetut asemat heti, kun olet verkossa."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de signal. La carte télécharge le monde entier, les eaux autour de vous et vos stations enregistrées dès que vous êtes connecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di segnale. La mappa scarica il mondo, le acque vicine e le stazioni salvate appena sei connesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続待ち。接続すると、世界地図、近くの水域、保存した観測所の地図をダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 대기 중. 연결되면 전 세계, 주변 해역, 저장한 관측소의 지도를 다운로드합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på signal. Kartet laster ned verden, farvannet rundt deg og de lagrede stasjonene dine så snart du er tilkoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op verbinding. De kaart downloadt de wereld, het water om je heen en je opgeslagen stations zodra je verbinding hebt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando sinal. O mapa baixa o mundo, as águas próximas e suas estações salvas assim que houver conexão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aguardar sinal. O mapa descarrega o mundo, as águas próximas e as suas estações guardadas assim que houver ligação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntar på signal. Kartan hämtar världen, vattnet omkring dig och dina sparade stationer så snart du är ansluten."
          }
        }
      }
    },
