    "More than half lit, filling toward full." : {
      "comment" : "Plain-language explanation of a waxing gibbous moon.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere end halvt belyst, vokser mod fuldmåne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als halb beleuchtet, auf dem Weg zum Vollmond."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de la mitad iluminada, creciendo hacia la luna llena."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yli puoliksi valaistu, kasvaa kohti täysikuuta."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de la moitié éclairée, en phase croissante vers la pleine lune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più di metà illuminata, verso la luna piena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半分以上が光り、満月へと満ちていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절반 이상 밝고 보름을 향해 차오릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer enn halvt belyst, og vokser mot fullmåne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer dan half verlicht, op weg naar volle maan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais da metade iluminada, crescendo até a lua cheia."
