          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater est à code source ouvert : cette app est sous GPL-3.0 et le moteur de prévision, sous MIT."
          }
        }
      }
    },
    "Slackwater needs calendar access to publish a station's events. Turn it on in Settings → Slackwater." : {
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
