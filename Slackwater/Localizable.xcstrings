    "%@ chart datum. Based on %@ tides and NOAA's published offsets; computed on this device." : {
      "comment" : "Offline-download interface text. Placeholders are runtime values shown in context.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ chart datum. Based on %2$@ tides and NOAA's published offsets; computed on this device."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zéro des cartes : %1$@. D’après les marées de %2$@ et les corrections publiées par NOAA; calculé sur cet appareil."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cero hidrográfico: %1$@. Basado en las mareas de %2$@ y los desfases publicados por NOAA; calculado en este dispositivo."
          }
        }
      }
    },
    "%@ chart datum. Downloaded from CHS (IWLS), then fitted and computed on this device. These are not CHS-published predictions." : {
