    "Slackwater retries automatically when a connection is available." : {
      "comment" : "Station download retry expectation.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater prøver automatisk igen, når der er forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater versucht es automatisch erneut, sobald eine Verbindung verfügbar ist."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater vuelve a intentarlo automáticamente cuando hay conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater yrittää automaattisesti uudelleen, kun verkkoyhteys on käytettävissä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater réessaie automatiquement dès qu’une connexion est disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater riprova automaticamente quando è disponibile una connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が利用できると、Slackwaterが自動で再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되면 Slackwater가 자동으로 다시 시도합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater prøver igjen automatisk når en tilkobling er tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater probeert het automatisch opnieuw zodra er een verbinding beschikbaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater tenta novamente automaticamente quando há conexão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater tenta novamente automaticamente quando há ligação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater försöker igen automatiskt när en anslutning finns."
          }
        }
      }
    },
    "Slackwater will stop publishing to this calendar, but calendar access is off, so it can't remove the calendar itself. Delete it by hand in Calendar if you don't want it anymore." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater stopper med at offentliggøre i denne kalender, men kalenderadgang er slået fra, så selve kalenderen kan ikke fjernes. Slet den manuelt i Kalender, hvis du ikke vil beholde den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater veröffentlicht keine weiteren Ereignisse in diesem Kalender. Da der Kalenderzugriff ausgeschaltet ist, kann der Kalender selbst nicht entfernt werden. Lösche ihn bei Bedarf manuell in der Kalender-App."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater dejará de publicar en este calendario, pero el acceso al calendario está desactivado, así que no puede eliminar el calendario. Elimínalo a mano en Calendario si ya no lo quieres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater lopettaa julkaisemisen tähän kalenteriin, mutta käyttöoikeus on estetty, joten se ei voi poistaa kalenteria. Poista kalenteri itse Kalenteri-sovelluksessa, jos et enää halua sitä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater cessera de publier dans ce calendrier, mais l’accès au calendrier est désactivé et il ne peut donc pas supprimer le calendrier lui-même. Supprimez-le manuellement dans Calendrier si vous n’en voulez plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater smetterà di pubblicare in questo calendario, ma l’accesso è disattivato e non può rimuovere il calendario stesso. Eliminalo manualmente in Calendario se non lo vuoi più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwaterはこのカレンダーへの公開を停止します。ただし、カレンダーへのアクセスがオフのため、カレンダー自体は削除できません。不要な場合は、カレンダーアプリで手動で削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater는 이 캘린더에 더 이상 게시하지 않습니다. 하지만 캘린더 접근이 꺼져 있어 캘린더를 삭제할 수 없습니다. 더 이상 필요하지 않으면 캘린더 앱에서 직접 삭제하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater slutter å publisere i denne kalenderen, men kalendertilgangen er av, så selve kalenderen kan ikke fjernes. Slett den manuelt i Kalender hvis du ikke vil ha den lenger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater stopt met publiceren in deze kalender, maar kalendertoegang staat uit, waardoor de kalender zelf niet kan worden verwijderd. Verwijder hem handmatig in Kalender als je hem niet meer wilt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater deixará de publicar neste calendário, mas o acesso ao calendário está desativado, então não pode remover o calendário em si. Exclua-o manualmente no Calendário se não quiser mais usá-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Slackwater deixará de publicar neste calendário, mas o acesso ao calendário está desativado e não pode apagar o próprio calendário. Apague-o manualmente no Calendário se já não o quiser."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater slutar publicera i den här kalendern, men kalenderåtkomsten är avstängd så själva kalendern kan inte tas bort. Radera den manuellt i Kalender om du inte vill ha den längre."
          }
        }
      }
    },
