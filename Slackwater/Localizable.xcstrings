    },
    "If you know who operates this station or how its data is licensed, let us know." : {
      "comment" : "Station discovery interface text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du weißt, wer diese Station betreibt oder wie ihre Daten lizenziert sind, lass es uns wissen."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sabes quién gestiona esta estación o qué licencia tienen sus datos, cuéntanoslo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous savez qui exploite cette station ou sous quelle licence ses données sont diffusées, dites-le-nous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この観測所の運営者やデータの利用許諾をご存じでしたら、お知らせください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi oss beskjed hvis du vet hvem som driver denne stasjonen, eller hvordan dataene er lisensiert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat het ons weten als je weet wie dit station beheert of hoe de gegevens zijn gelicentieerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sabe quem opera esta estação ou qual é a licença dos dados, conte para nós."
          }
        }
      }
    },
    "In Earth's faint outer shadow — a dimming, not a bite." : {
      "comment" : "Plain-language explanation of a penumbral lunar eclipse.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im schwachen äußeren Erdschatten — etwas dunkler, ohne sichtbare Einkerbung."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la tenue sombra exterior de la Tierra: un oscurecimiento, no un mordisco."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la faible pénombre de la Terre — un assombrissement, pas une échancrure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球の薄い外側の影に入り、欠けずに少し暗くなります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Jordens svake ytre skygge — mørkere, uten en bit som mangler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de zwakke buitenste schaduw van de aarde — minder helder, zonder hap eruit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na penumbra da Terra — um escurecimento, sem recorte."
          }
        }
      }
    },
