          }
        }
      }
    },
    "Stay connected for %@ more and Slackwater refines it to the full %lld-day model, in place — nothing to tap." : {
      "comment" : "Online prediction-refinement explanation. Values are an approximate duration and model length in days.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibe noch %1$@ verbunden, dann verfeinert Slackwater die Vorhersage zum vollständigen %2$lld-Tage-Modell — ganz automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stay connected for %1$@ more and Slackwater refines it to the full %2$lld-day model, in place — nothing to tap."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la conexión %@ más y Slackwater la refinará al modelo completo de %lld días, sin que tengas que tocar nada."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez connecté encore %1$@ et Slackwater affinera cette réponse grâce au modèle complet de %2$lld jours, sans aucune action de votre part."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あと%1$@接続を続けると、Slackwaterが%2$lld日分の完全なモデルに自動で更新します。操作は不要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold tilkoblingen i %1$@ til, så finjusterer Slackwater resultatet til hele %2$lld-dagersmodellen, på stedet — du trenger ikke trykke på noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf nog %1$@ verbonden en Slackwater verfijnt dit tot het volledige model van %2$lld dagen, op dezelfde plek — je hoeft niets aan te tikken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a conexão por mais %1$@ e Slackwater refina o resultado para o modelo completo de %2$lld dias, automaticamente — sem precisar tocar."
          }
        }
      }
    },
