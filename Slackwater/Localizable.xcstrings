    "NOAA harmonic current prediction. Flood sets %lld°T. Speeds use %@." : {
      "comment" : "Tide and current interface text. Placeholders are runtime values shown in context.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harmonische NOAA-Strömungsvorhersage. Flutstrom setzt nach %1$lld°T. Geschwindigkeiten in %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NOAA harmonic current prediction. Flood sets %1$lld°T. Speeds use %2$@."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predicción armónica de corrientes de NOAA. La corriente de flujo se establece a %1$lld°T. Las velocidades usan %2$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévision harmonique de courant NOAA. Le flot porte au %1$lld°T. Vitesses exprimées en %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOAAの調和解析による潮流予測。上げ潮流の流向は%1$lld°T。流速の単位は%2$@です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harmonisk strømprognose fra NOAA. Inngående strøm setter mot %1$lld°T. Hastighetene bruker %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harmonische NOAA-stroomvoorspelling. De vloedstroom zet naar %1$lld°T. Snelheden in %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsão harmônica de correntes NOAA. A enchente segue para %1$lld°T. As velocidades usam %2$@."
          }
        }
      }
    },
    "NOAA reference slacks and maxima, adjusted by published offsets and computed on this device" : {
      "comment" : "Station-detail prediction provenance. Keep NOAA exact.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOAA-Referenzzeiten für Stauwasser und Strömungsmaxima, mit veröffentlichten Korrekturen angepasst und auf diesem Gerät berechnet"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoas y máximos de referencia de NOAA, ajustados con los desfases publicados y calculados en este dispositivo"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étales et maximums de référence NOAA, corrigés selon les décalages publiés et calculés sur cet appareil"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOAA基準観測所の潮止まりと最強流を公開補正値で調整し、このデバイスで計算しています"
          }
        },
        "nb" : {
          "stringUnit" : {
