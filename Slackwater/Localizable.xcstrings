    "Slackwater" : {
      "shouldTranslate" : false
    },
    "Slackwater computes harmonic tide and current predictions on this device. They are not observations; actual conditions vary with weather, river flow, and local effects." : {
      "comment" : "Tide and current interface text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater berechnet harmonische Gezeiten- und Strömungsvorhersagen auf diesem Gerät. Sie sind keine Messungen; die tatsächlichen Bedingungen hängen von Wetter, Flussabfluss und örtlichen Einflüssen ab."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater calcula predicciones armónicas de mareas y corrientes en este dispositivo. No son observaciones; las condiciones reales varían con el tiempo, el caudal de los ríos y los efectos locales."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater calcule les prévisions harmoniques des marées et courants sur cet appareil. Il ne s’agit pas d’observations; les conditions réelles varient selon la météo, le débit des cours d’eau et les effets locaux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwaterはこのデバイスで、調和解析による潮汐と潮流の予測を計算します。観測値ではありません。実際の状況は、天候、河川の流量、地域の条件によって変わります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater beregner harmoniske tidevanns- og strømprognoser på denne enheten. De er ikke observasjoner; faktiske forhold varierer med vær, elveføring og lokale effekter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater berekent harmonische getij- en stroomvoorspellingen op dit apparaat. Het zijn geen waarnemingen; de werkelijke omstandigheden variëren door het weer, rivierafvoer en lokale invloeden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater calcula previsões harmônicas de marés e correntes neste dispositivo. Não são observações; as condições reais variam com o clima, a vazão dos rios e os efeitos locais."
          }
        }
      }
    },
    "Slackwater couldn't create a calendar for it. Some calendar accounts — Google, Exchange — don't allow new calendars." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater konnte dafür keinen Kalender erstellen. Einige Kalenderkonten — Google, Exchange — erlauben keine neuen Kalender."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater no pudo crear un calendario para esta estación. Algunas cuentas de calendario — Google, Exchange — no permiten crear calendarios."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater n’a pas pu créer de calendrier pour cette station. Certains comptes de calendrier — Google, Exchange — n’autorisent pas la création de calendriers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーを作成できませんでした。GoogleやExchangeなど、一部のカレンダーアカウントでは新しいカレンダーを作成できません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater kunne ikke opprette en kalender for stedet. Noen kalenderkontoer — Google, Exchange — tillater ikke nye kalendere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater kon hiervoor geen kalender maken. Sommige kalenderaccounts — Google, Exchange — staan geen nieuwe kalenders toe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater não conseguiu criar um calendário para este lugar. Algumas contas de calendário — Google, Exchange — não permitem novos calendários."
          }
        }
      }
    },
    "Slackwater couldn't find a slack window for your nearest current station." : {
