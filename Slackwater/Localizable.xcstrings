    "It has been withdrawn from the hydrographic service, so it has no readings to show." : {
      "comment" : "Removed-station explanation.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er fjernet fra den hydrografiske tjeneste og har derfor ingen målinger at vise."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der hydrographische Dienst hat sie zurückgezogen, daher sind keine Werte verfügbar."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha retirado del servicio hidrográfico, por lo que no hay lecturas que mostrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydrografinen palvelu on poistanut aseman, joten lukemia ei ole näytettävissä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a été retirée du service hydrographique et n’a donc aucun relevé à afficher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stata ritirata dal servizio idrografico e non ha dati da mostrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水路機関による公開が終了したため、表示できるデータがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수로 기관에서 더 이상 제공하지 않아 표시할 수치가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er trukket fra den hydrografiske tjenesten og har ingen målinger å vise."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hydrografische dienst heeft het station ingetrokken, waardoor er geen waarden meer zijn om te tonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi retirada do serviço hidrográfico e não tem leituras para exibir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi retirada do serviço hidrográfico e não tem leituras para mostrar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den har tagits bort från den hydrografiska tjänsten och har därför inga värden att visa."
          }
        }
      }
    },
    "It has been withdrawn from the hydrographic service, so it has no readings to show. Swipe to remove it." : {
      "comment" : "Removed favorite-station explanation.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er fjernet fra den hydrografiske tjeneste og har derfor ingen målinger at vise. Skub for at fjerne den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der hydrographische Dienst hat sie zurückgezogen, daher sind keine Werte verfügbar. Streiche, um sie zu entfernen."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha retirado del servicio hidrográfico, por lo que no hay lecturas que mostrar. Desliza para eliminarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydrografinen palvelu on poistanut aseman, joten lukemia ei ole näytettävissä. Poista pyyhkäisemällä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirée du service hydrographique, elle ne fournit plus de relevés. Balayez pour la supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stata ritirata dal servizio idrografico e non ha dati da mostrare. Scorri per rimuoverla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水路機関による公開が終了したため、表示できるデータがありません。スワイプして削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수로 기관에서 더 이상 제공하지 않아 표시할 수치가 없습니다. 쓸어넘겨 삭제하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er trukket fra den hydrografiske tjenesten og har ingen målinger å vise. Sveip for å fjerne den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
