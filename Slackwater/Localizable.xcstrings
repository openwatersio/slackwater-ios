    "Slackwater" : {
      "shouldTranslate" : false
    },
    "Slackwater computes harmonic tide and current predictions on this device. They are not observations; actual conditions vary with weather, river flow, and local effects." : {
      "comment" : "Tide and current interface text.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater calcula predicciones armónicas de mareas y corrientes en este dispositivo. No son observaciones; las condiciones reales varían con el tiempo, el caudal de los ríos y los efectos locales."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater calcule les prévisions harmoniques des marées et courants sur cet appareil. Il ne s’agit pas d’observations; les conditions réelles varient selon la météo, le débit des cours d’eau et les effets locaux."
          }
        }
      }
    },
    "Slackwater couldn't create a calendar for it. Some calendar accounts — Google, Exchange — don't allow new calendars." : {
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater no pudo crear un calendario para esta estación. Algunas cuentas de calendario — Google, Exchange — no permiten crear calendarios."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater n’a pas pu créer de calendrier pour cette station. Certains comptes de calendrier — Google, Exchange — n’autorisent pas la création de calendriers."
          }
        }
      }
    },
    "Slackwater couldn't find a slack window for your nearest current station." : {
      "comment" : "Spoken Siri failure response.",
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
