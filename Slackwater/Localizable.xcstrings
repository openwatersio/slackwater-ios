    "Slackwater estimates %@ slack times from high and low water at %@, using a cruising rule of thumb. CHS does not publish current predictions for this pass." : {
      "comment" : "Tide and current interface text. Placeholders are runtime values shown in context.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater schätzt die Stauwasserzeiten für %1$@ anhand von Hoch- und Niedrigwasser bei %2$@ mit einer Faustregel für die Fahrtplanung. CHS veröffentlicht keine Strömungsvorhersagen für diese Passage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Slackwater estimates %1$@ slack times from high and low water at %2$@, using a cruising rule of thumb. CHS does not publish current predictions for this pass."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater estima las horas de estoa de %@ a partir de la pleamar y la bajamar en %@, mediante una regla práctica de navegación. CHS no publica predicciones de corrientes para este paso."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater estime %1$@ périodes d’étale à partir des hautes et basses eaux à %2$@, selon une règle empirique de navigation. CHS ne publie pas de prévisions de courant pour ce passage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwaterは航行時の経験則を用い、%2$@の満潮・干潮から%1$@の潮止まり時刻を推定します。CHSはこの水道の潮流予測を公開していません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater anslår strømstille ved %1$@ fra høyvann og lavvann ved %2$@ med en tommelfingerregel for fritidsbåter. CHS publiserer ikke strømprognoser for dette sundet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater schat de kenteringen bij %1$@ op basis van hoog- en laagwater bij %2$@, met een vuistregel voor toervaren. CHS publiceert geen stroomvoorspellingen voor deze doorgang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater estima os horários de estofo de %1$@ a partir das preamares e baixa-mares de %2$@, usando uma regra prática de navegação de recreio. O CHS não publica previsões de correntes para esta passagem."
          }
        }
      }
    },
    "Slackwater is open source: this app under GPL-3.0, the prediction engine under MIT." : {
      "comment" : "Tide and current interface text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater ist Open Source: diese App unter GPL-3.0, die Vorhersage-Engine unter MIT."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater es de código abierto: esta app usa GPL-3.0 y el motor de predicción usa MIT."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater est à code source ouvert : cette app est sous GPL-3.0 et le moteur de prévision, sous MIT."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwaterはオープンソースです。アプリはGPL-3.0、予測エンジンはMITライセンスで公開しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater har åpen kildekode: appen under GPL-3.0, prognosemotoren under MIT."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater is opensource: deze app onder GPL-3.0, de voorspellingsengine onder MIT."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater é de código aberto: este app sob GPL-3.0, o motor de previsão sob MIT."
          }
        }
      }
    },
    "Slackwater needs calendar access to publish a station's events. Turn it on in Settings → Slackwater." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater benötigt Kalenderzugriff, um die Ereignisse einer Station zu veröffentlichen. Aktiviere ihn unter Einstellungen → Slackwater."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater necesita acceso al calendario para publicar los eventos de una estación. Actívalo en Ajustes → Slackwater."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater a besoin d’accéder au calendrier pour publier les événements d’une station. Activez-le dans Réglages → Slackwater."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "観測所の予定を公開するには、カレンダーへのアクセスが必要です。「設定」→ Slackwaterで許可してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater trenger kalendertilgang for å publisere hendelser for en stasjon. Slå den på i Innstillinger → Slackwater."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater heeft kalendertoegang nodig om de gebeurtenissen van een station te publiceren. Zet dit aan in Instellingen → Slackwater."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slackwater precisa de acesso ao calendário para publicar eventos de uma estação. Ative em Ajustes → Slackwater."
          }
        }
      }
    },
