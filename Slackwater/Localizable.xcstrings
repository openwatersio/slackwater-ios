    "Fully inside Earth's shadow, reddened by Earth's sunsets." : {
      "comment" : "Plain-language explanation of a total lunar eclipse.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt inde i Jordens skygge, rødfarvet af Jordens solnedgange."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollständig im Erdschatten, rötlich durch die Sonnenuntergänge auf der Erde."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente dentro de la sombra oscura de la Tierra, enrojecida por los atardeceres terrestres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokonaan Maan varjossa, Maan auringonlaskujen punaiseksi värjäämä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entièrement dans l’ombre de la Terre, rougie par les couchers de soleil terrestres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interamente nell’ombra terrestre, arrossata dai tramonti della Terra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月全体が地球の影に入り、地球の夕焼けの光で赤く見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지구의 그림자 안에 완전히 들어가 지구의 일몰 빛으로 붉게 보입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt inne i Jordens skygge, rødfarget av Jordens solnedganger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig in de schaduw van de aarde, rood gekleurd door de aardse zonsondergangen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inteiramente na sombra da Terra, avermelhada pelos pores do sol terrestres."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inteiramente na sombra da Terra, avermelhada pelos pores do sol terrestres."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt inne i jordens skugga, rödfärgad av jordens solnedgångar."
          }
        }
      }
    },
    "Get the next high tide at your local Slackwater station." : {
