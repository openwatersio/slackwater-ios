        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladatut ennusteet ovat valmiina ilman verkkoyhteyttä. Vanhenevien latausten jäljellä oleva aika näkyy alla."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prévisions téléchargées sont prêtes pour une utilisation hors ligne. Les téléchargements qui expirent affichent leur temps restant ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le previsioni scaricate sono pronte offline. I download con scadenza mostrano qui sotto il tempo rimasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みの予測はオフラインで利用できます。有効期限のあるデータは、残り時間を下に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 예측을 오프라인에서 사용할 수 있습니다. 만료되는 다운로드의 남은 시간은 아래에 표시됩니다."
