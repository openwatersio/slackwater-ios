    "Estimated wait: %@. The station downloads once and stays available offline." : {
      "comment" : "Station download expectation. The value is an approximate duration.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslået ventetid: %@. Stationen hentes én gang og forbliver tilgængelig offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzte Wartezeit: %@. Die Station wird einmal geladen und bleibt offline verfügbar."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de espera estimado: %@. La estación se descarga una vez y queda disponible sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvioitu odotusaika: %@. Asema ladataan kerran ja pysyy käytettävissä ilman verkkoyhteyttä."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps d’attente estimé : %@. La station est téléchargée une fois et reste disponible hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attesa stimata: %@. La stazione si scarica una volta e resta disponibile offline."
