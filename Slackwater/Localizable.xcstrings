          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOAA-referentietijden voor kenteringen en stroommaxima, aangepast met gepubliceerde correcties en berekend op dit apparaat"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
